# データベース（Neonの接続文字列。プーラー経由のURLを推奨）
# プーラー（PgBouncer方式のトランザクションモード）を経由する場合は
# 末尾に &pgbouncer=true を付けること。付けないと稀に
# "prepared statement ... already exists" エラーが発生する。
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"

# Auth.js
# 生成方法: openssl rand -base64 32
AUTH_SECRET=""
# 開発時はそのまま。本番ではデプロイ先の実URLに変更する
AUTH_URL="http://localhost:3000"

# Google OAuth（Google Cloud Console で発行）
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
